<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_Orchestrator_FindQueueItemByReference" this:Workflows_Orchestrator_FindQueueItemByReference.in_WaitUntilFoundSeconds="0" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:this="clr-namespace:" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_QueueName" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Orchestrator folder of the queue. Empty = folder the job runs in." Name="in_QueueFolder" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Exact Reference to look for (FilterStrategy Equals)." Name="in_Reference" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Orchestrator lists a just-added item only after a short delay. 0 (default) = look once. &gt; 0 = keep looking (every second) until found or this many seconds have passed - use it whenever the item is expected to exist." Name="in_WaitUntilFoundSeconds" Type="InArgument(x:Int32)" />
    <x:Property sap2010:Annotation.AnnotationText="True when at least one item (any status) has this Reference." Name="out_Found" Type="OutArgument(x:Boolean)" />
    <x:Property sap2010:Annotation.AnnotationText="Specific content of the found item (empty dictionary when not found)." Name="out_SpecificContent" Type="OutArgument(scg:Dictionary(x:String, x:Object))" />
    <x:Property sap2010:Annotation.AnnotationText="Status of the found item (empty when not found)." Name="out_Status" Type="OutArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Number of items with exactly this Reference (Orchestrator retries count as separate items; at most 10 are read)." Name="out_Count" Type="OutArgument(x:Int32)" />
  </x:Members>
  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>
  <sap2010:WorkflowViewState.IdRef>ActivityBuilder_1</sap2010:WorkflowViewState.IdRef>
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="32">
      <x:String>GlobalConstantsNamespace</x:String>
      <x:String>GlobalVariablesNamespace</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <scg:List x:TypeArguments="AssemblyReference" Capacity="32">
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.Collections</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System.Runtime</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Workflow</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>
  <Sequence sap2010:Annotation.AnnotationText="Looks up queue items by exact Reference (all states). Read-only. Used to recover after a partial failure: when the Lyrebird_Wishlist item already exists, its content is the record of what was decided.&#xA;Several items can share a Reference (Orchestrator retries); the newest retry is returned - they carry the same content." DisplayName="Find Queue Item By Reference" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:IEnumerable(ui:QueueItem)" Name="Items" />
      <Variable x:TypeArguments="ui:QueueItem" Name="Item" />
      <Variable x:TypeArguments="x:String" Name="QueueFolder" />
      <Variable x:TypeArguments="s:DateTime" Name="Deadline" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <Assign x:TypeArguments="x:String" DisplayName="Assign QueueFolder" sap2010:WorkflowViewState.IdRef="Assign_1" To="[QueueFolder]" Value="[If(String.IsNullOrWhiteSpace(in_QueueFolder), Nothing, in_QueueFolder.Trim())]" />
    <Assign x:TypeArguments="s:DateTime" DisplayName="Assign Deadline" sap2010:WorkflowViewState.IdRef="Assign_7" To="[Deadline]" Value="[DateTime.UtcNow.AddSeconds(Math.Max(0, in_WaitUntilFoundSeconds))]" />
    <ui:InterruptibleDoWhile sap2010:Annotation.AnnotationText="Read-after-write delay: Get Queue Items may not list an item that was added a moment ago (observed in the integration tests)." DisplayName="Do While not found and waiting allowed" sap2010:WorkflowViewState.IdRef="InterruptibleDoWhile_1">
      <ui:InterruptibleDoWhile.Body>
        <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:GetQueueItems Duration="{x:Null}" From="{x:Null}" Priority="{x:Null}" Skip="{x:Null}" TimeoutMS="{x:Null}" To="{x:Null}" DisplayName="Get queue items by Reference" FilterStrategy="Equals" FolderPath="[QueueFolder]" QueueItemStates="All" QueueName="[in_QueueName]" Reference="[in_Reference]" Result="[Items]" Top="[10]" sap2010:WorkflowViewState.IdRef="GetQueueItems_1" />
          <Assign x:TypeArguments="ui:QueueItem" DisplayName="Assign Item" sap2010:WorkflowViewState.IdRef="Assign_2" To="[Item]" Value="[If(Items Is Nothing, Nothing, Items.Where(Function(i) String.Equals(i.Reference, in_Reference, StringComparison.OrdinalIgnoreCase)).OrderByDescending(Function(i) i.RetryNo).FirstOrDefault())]" />
          <If Condition="[Item Is Nothing AndAlso DateTime.UtcNow &lt; Deadline]" DisplayName="If not visible yet" sap2010:WorkflowViewState.IdRef="If_1">
            <If.Then>
              <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
                <Delay DisplayName="Delay 1 s" Duration="00:00:01" sap2010:WorkflowViewState.IdRef="Delay_1" />
              </Sequence>
            </If.Then>
          </If>
        </Sequence>
      </ui:InterruptibleDoWhile.Body>
      <ui:InterruptibleDoWhile.Condition>[Item Is Nothing AndAlso DateTime.UtcNow &lt; Deadline]</ui:InterruptibleDoWhile.Condition>
    </ui:InterruptibleDoWhile>
    <Assign x:TypeArguments="x:Int32" DisplayName="Assign out_Count" sap2010:WorkflowViewState.IdRef="Assign_6" To="[out_Count]" Value="[If(Items Is Nothing, 0, Items.Count(Function(i) String.Equals(i.Reference, in_Reference, StringComparison.OrdinalIgnoreCase)))]" />
    <Assign x:TypeArguments="x:Boolean" DisplayName="Assign out_Found" sap2010:WorkflowViewState.IdRef="Assign_3" To="[out_Found]" Value="[Item IsNot Nothing]" />
    <Assign x:TypeArguments="scg:Dictionary(x:String, x:Object)" DisplayName="Assign out_SpecificContent" sap2010:WorkflowViewState.IdRef="Assign_4" To="[out_SpecificContent]" Value="[If(Item Is Nothing OrElse Item.SpecificContent Is Nothing, New Dictionary(Of String, Object)(), New Dictionary(Of String, Object)(Item.SpecificContent))]" />
    <Assign x:TypeArguments="x:String" DisplayName="Assign out_Status" sap2010:WorkflowViewState.IdRef="Assign_5" To="[out_Status]" Value="[If(Item Is Nothing, String.Empty, Item.Status.ToString())]" />
    <ui:LogMessage DisplayName="Log result" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[$&quot;Queue '{in_QueueName}': Reference {in_Reference} {If(out_Found, $&quot;found (status {out_Status})&quot;, &quot;not found&quot;)}.&quot;]" />
  </Sequence>
</Activity>
