<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_Orchestrator_AddQueueItemIdempotent" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property sap2010:Annotation.AnnotationText="Queue to add to. It must be created with 'Enforce unique references' = Yes." Name="in_QueueName" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Orchestrator folder of the queue. Empty = folder the job runs in." Name="in_QueueFolder" Type="InArgument(x:String)" />
    <x:Property Name="in_Reference" Type="InArgument(x:String)" />
    <x:Property Name="in_ItemInformation" Type="InArgument(scg:Dictionary(x:String, x:Object))" />
    <x:Property sap2010:Annotation.AnnotationText="added | already_exists" Name="out_Result" Type="OutArgument(x:String)" />
  </x:Members>
  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>
  <sap2010:WorkflowViewState.IdRef>ActivityBuilder_1</sap2010:WorkflowViewState.IdRef>
  <TextExpression.NamespacesForImplementation>
    <scg:List x:TypeArguments="x:String" Capacity="32">
      <x:String>GlobalConstantsNamespace</x:String>
      <x:String>GlobalVariablesNamespace</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Text.RegularExpressions</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </scg:List>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <scg:List x:TypeArguments="AssemblyReference" Capacity="32">
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.Collections</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Net.Primitives</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System.Runtime</AssemblyReference>
      <AssemblyReference>System.Text.RegularExpressions</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Workflow</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
    </scg:List>
  </TextExpression.ReferencesForImplementation>
  <Sequence sap2010:Annotation.AnnotationText="Adds one queue item; safe to call again with the same Reference.&#xA;Only a CONFIRMED duplicate (OrchestratorHttpException, HTTP 409, message 'duplicate reference' / 'reference already exists') is absorbed as already_exists - the same rule as LoadNewWishlistItems.xaml. Every other error is logged and rethrown." DisplayName="Add Queue Item Idempotent" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="QueueFolder" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <Assign x:TypeArguments="x:String" DisplayName="Assign QueueFolder" sap2010:WorkflowViewState.IdRef="Assign_1" To="[QueueFolder]" Value="[If(String.IsNullOrWhiteSpace(in_QueueFolder), Nothing, in_QueueFolder.Trim())]" />
    <TryCatch DisplayName="Try add queue item" sap2010:WorkflowViewState.IdRef="TryCatch_1">
      <TryCatch.Try>
        <Sequence DisplayName="Try" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:AddQueueItem TimeoutMS="{x:Null}" DisplayName="Add queue item" FolderPath="[QueueFolder]" ItemInformationCollection="[in_ItemInformation]" Priority="Normal" QueueType="[in_QueueName]" Reference="[in_Reference]" sap2010:WorkflowViewState.IdRef="AddQueueItem_1">
            <ui:AddQueueItem.ItemInformation>
              <scg:Dictionary x:TypeArguments="x:String, InArgument" />
            </ui:AddQueueItem.ItemInformation>
          </ui:AddQueueItem>
          <Assign x:TypeArguments="x:String" DisplayName="Assign out_Result added" sap2010:WorkflowViewState.IdRef="Assign_2" To="[out_Result]" Value="added" />
          <ui:LogMessage DisplayName="Log added" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[$&quot;Queue '{in_QueueName}': {in_Reference} ADDED.&quot;]" />
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="ui:OrchestratorHttpException" sap2010:WorkflowViewState.IdRef="Catch`1_1">
          <ActivityAction x:TypeArguments="ui:OrchestratorHttpException">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="ui:OrchestratorHttpException" Name="httpException" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Catch OrchestratorHttpException" sap2010:WorkflowViewState.IdRef="Sequence_3">
              <If Condition="[CInt(httpException.StatusCode) = 409 AndAlso Regex.IsMatch(If(httpException.Message, String.Empty), &quot;duplicate\s+reference|reference\s+already\s+exists&quot;, RegexOptions.IgnoreCase)]" DisplayName="If confirmed duplicate reference" sap2010:WorkflowViewState.IdRef="If_1">
                <If.Then>
                  <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_4">
                    <Assign x:TypeArguments="x:String" DisplayName="Assign out_Result already_exists" sap2010:WorkflowViewState.IdRef="Assign_3" To="[out_Result]" Value="already_exists" />
                    <ui:LogMessage DisplayName="Log already exists" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[$&quot;Queue '{in_QueueName}': {in_Reference} already exists (HTTP {CInt(httpException.StatusCode)} {System.Text.RegularExpressions.Regex.Replace(If(httpException.Message, String.Empty), &quot;(?i)(authorization|apikey|api_key|bearer|password|secret)([\s&quot;&quot;':=]+)[^\s&quot;&quot;',;}]+&quot;, &quot;$1$2***&quot;)}).&quot;]" />
                  </Sequence>
                </If.Then>
                <If.Else>
                  <Sequence DisplayName="Else" sap2010:WorkflowViewState.IdRef="Sequence_5">
                    <ui:LogMessage DisplayName="Log Orchestrator error" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Error" Message="[$&quot;Queue '{in_QueueName}': adding {in_Reference} FAILED: HTTP {CInt(httpException.StatusCode)} {System.Text.RegularExpressions.Regex.Replace(If(httpException.Message, String.Empty), &quot;(?i)(authorization|apikey|api_key|bearer|password|secret)([\s&quot;&quot;':=]+)[^\s&quot;&quot;',;}]+&quot;, &quot;$1$2***&quot;)}&quot;]" />
                    <Rethrow DisplayName="Rethrow Orchestrator error" sap2010:WorkflowViewState.IdRef="Rethrow_1" />
                  </Sequence>
                </If.Else>
              </If>
            </Sequence>
          </ActivityAction>
        </Catch>
        <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch`1_2">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Catch Exception" sap2010:WorkflowViewState.IdRef="Sequence_6">
              <ui:LogMessage DisplayName="Log add failed" sap2010:WorkflowViewState.IdRef="LogMessage_4" Level="Error" Message="[$&quot;Queue '{in_QueueName}': adding {in_Reference} FAILED: {exception.GetType().Name}: {System.Text.RegularExpressions.Regex.Replace(If(exception.Message, String.Empty), &quot;(?i)(authorization|apikey|api_key|bearer|password|secret)([\s&quot;&quot;':=]+)[^\s&quot;&quot;',;}]+&quot;, &quot;$1$2***&quot;)}&quot;]" />
              <Rethrow DisplayName="Rethrow add failed" sap2010:WorkflowViewState.IdRef="Rethrow_2" />
            </Sequence>
          </ActivityAction>
        </Catch>
      </TryCatch.Catches>
    </TryCatch>
  </Sequence>
</Activity>
