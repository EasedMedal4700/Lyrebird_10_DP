  <Sequence sap2010:Annotation.AnnotationText="Reads the queue definition from Orchestrator (GET /odata/QueueDefinitions, robot credentials, Queues: View) so Main uses the queue's REAL retry settings instead of a copy in Config. Throws when the queue does not exist or cannot be read." DisplayName="Get Queue Settings" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="ResponseJson" />
      <Variable x:TypeArguments="x:Int32" Name="StatusCode" />
      <Variable x:TypeArguments="njl:JArray" Name="Definitions" />
      <Variable x:TypeArguments="njl:JObject" Name="Definition" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:OrchestratorHttpRequest JSONPayload="{x:Null}" ResponseHeaders="{x:Null}" TimeoutMS="{x:Null}" DisplayName="Orchestrator GET queue definition" FolderPath="[in_QueueFolder]" sap2010:WorkflowViewState.IdRef="OrchestratorHttpRequest_1" Method="GET" RelativeEndpoint="[&quot;/odata/QueueDefinitions?$filter=&quot; &amp; Uri.EscapeDataString($&quot;Name eq '{If(in_QueueName, String.Empty).Trim().Replace(&quot;'&quot;, &quot;''&quot;)}'&quot;)]" Result="[ResponseJson]" StatusCode="[StatusCode]" />
    <If Condition="[StatusCode &lt;&gt; 200]" DisplayName="If the request failed" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Throw DisplayName="Throw request failed" Exception="[New Exception($&quot;GetQueueSettings: Orchestrator returned HTTP {StatusCode} for queue '{in_QueueName}' in folder '{in_QueueFolder}': {If(ResponseJson, String.Empty)}&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_1" />
      </If.Then>
    </If>
    <Assign x:TypeArguments="njl:JArray" DisplayName="Assign Definitions" sap2010:WorkflowViewState.IdRef="Assign_1" To="[Definitions]" Value="[If(TryCast(JObject.Parse(ResponseJson)(&quot;value&quot;), JArray), New JArray())]" />
    <If Condition="[Definitions.Count &lt;&gt; 1]" DisplayName="If the queue is not found exactly once" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Then>
        <Throw DisplayName="Throw queue not found" Exception="[New Exception($&quot;GetQueueSettings: queue '{in_QueueName}' not found in folder '{in_QueueFolder}' ({Definitions.Count} match(es)).&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_2" />
      </If.Then>
    </If>
    <Assign x:TypeArguments="njl:JObject" DisplayName="Assign Definition" sap2010:WorkflowViewState.IdRef="Assign_2" To="[Definition]" Value="[CType(Definitions(0), JObject)]" />
    <Assign x:TypeArguments="x:Int32" DisplayName="Assign out_MaxRetries" sap2010:WorkflowViewState.IdRef="Assign_3" To="[out_MaxRetries]" Value="[If(Definition.Value(Of Integer?)(&quot;MaxNumberOfRetries&quot;), 0)]" />
    <Assign x:TypeArguments="x:Boolean" DisplayName="Assign out_AutoRetry" sap2010:WorkflowViewState.IdRef="Assign_4" To="[out_AutoRetry]" Value="[If(Definition.Value(Of Boolean?)(&quot;AcceptAutomaticallyRetry&quot;), False)]" />
    <Assign x:TypeArguments="x:Boolean" DisplayName="Assign out_EnforceUniqueReference" sap2010:WorkflowViewState.IdRef="Assign_5" To="[out_EnforceUniqueReference]" Value="[If(Definition.Value(Of Boolean?)(&quot;EnforceUniqueReference&quot;), False)]" />
    <ui:LogMessage DisplayName="Log queue settings" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[$&quot;Queue '{in_QueueName}' ({in_QueueFolder}): auto retry {out_AutoRetry}, max retries {out_MaxRetries}, unique references {out_EnforceUniqueReference}.&quot;]" />
  </Sequence>
