      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Throw DisplayName="Throw invalid arguments" Exception="[New ArgumentException($&quot;GetReleaseGroupReleases needs a release group MBID and a User-Agent (got '{in_ReleaseGroupMbid}').&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_1" />
        </Sequence>
      </If.Then>
    </If>
    <Assign x:TypeArguments="njl:JArray" DisplayName="Assign out_Releases" sap2010:WorkflowViewState.IdRef="Assign_1" To="[out_Releases]" Value="[New JArray()]" />
