          <Sequence.Variables>
            <Variable x:TypeArguments="x:String" Name="RequestUrl" />
            <Variable x:TypeArguments="x:TimeSpan" Name="Wait" />
            <Variable x:TypeArguments="uwahm:HttpResponseSummary" Name="Response" />
            <Variable x:TypeArguments="njl:JObject" Name="Json" />
          </Sequence.Variables>
          <Assign x:TypeArguments="x:String" DisplayName="Assign RequestUrl" sap2010:WorkflowViewState.IdRef="Assign_2" To="[RequestUrl]" Value="[$&quot;{BaseUrl}?release-group={in_ReleaseGroupMbid}&amp;inc=media&amp;fmt=json&amp;limit={PageSize}&amp;offset={Offset}&quot;]" />
          <Assign x:TypeArguments="x:TimeSpan" DisplayName="Assign Wait" sap2010:WorkflowViewState.IdRef="Assign_3" To="[Wait]" Value="[MinInterval - (DateTime.UtcNow - io_LastRequestUtc)]" />
          <If Condition="[Wait &gt; TimeSpan.Zero]" DisplayName="If last request was less than 1.1 s ago" sap2010:WorkflowViewState.IdRef="If_2">
            <If.Then>
