          <If Condition="[CInt(Response.StatusCode) &lt; 200 OrElse CInt(Response.StatusCode) &gt;= 300]" DisplayName="If MusicBrainz returned an error" sap2010:WorkflowViewState.IdRef="If_3">
            <If.Then>
              <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_7">
                <Throw DisplayName="Throw HTTP error (retryable)" Exception="[New Exception($&quot;MusicBrainz release lookup for release group {in_ReleaseGroupMbid} returned HTTP {CInt(Response.StatusCode)}: &quot; &amp; If(String.IsNullOrEmpty(Response.TextContent), String.Empty, Response.TextContent.Substring(0, Math.Min(300, Response.TextContent.Length))))]" sap2010:WorkflowViewState.IdRef="Throw_2" />
              </Sequence>
            </If.Then>
          </If>
          <ui:DeserializeJson x:TypeArguments="njl:JObject" JsonSample="{x:Null}" Settings="{x:Null}" DisplayName="Deserialize page" sap2010:WorkflowViewState.IdRef="DeserializeJson_1" JsonObject="[Json]" JsonString="[Response.TextContent]" />
          <Assign x:TypeArguments="x:Int32" DisplayName="Assign Returned" sap2010:WorkflowViewState.IdRef="Assign_6" To="[Returned]" Value="[If(Json(&quot;releases&quot;) Is Nothing, 0, Json(&quot;releases&quot;).Count())]" />
          <Assign x:TypeArguments="x:Int32" DisplayName="Assign Total" sap2010:WorkflowViewState.IdRef="Assign_7" To="[Total]" Value="[If(Json.Value(Of Integer?)(&quot;release-count&quot;), 0)]" />
          <Assign x:TypeArguments="njl:JArray" DisplayName="Append releases" sap2010:WorkflowViewState.IdRef="Assign_8" To="[out_Releases]" Value="[If(Returned = 0, out_Releases, New JArray(out_Releases.Concat(Json(&quot;releases&quot;))))]" />
          <Assign x:TypeArguments="x:Int32" DisplayName="Assign Offset" sap2010:WorkflowViewState.IdRef="Assign_9" To="[Offset]" Value="[Offset + Returned]" />
          <Assign x:TypeArguments="x:Int32" DisplayName="Assign Page" sap2010:WorkflowViewState.IdRef="Assign_10" To="[Page]" Value="[Page + 1]" />
        </Sequence>
      </ui:InterruptibleDoWhile.Body>
      <ui:InterruptibleDoWhile.Condition>[Returned &gt; 0 AndAlso Offset &lt; Total AndAlso Page &lt; in_MaxPages]</ui:InterruptibleDoWhile.Condition>
