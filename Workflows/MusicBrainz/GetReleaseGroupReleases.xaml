                    <Assign x:TypeArguments="s:DateTime" DisplayName="Assign io_LastRequestUtc" sap2010:WorkflowViewState.IdRef="Assign_5" To="[io_LastRequestUtc]" Value="[DateTime.UtcNow]" />
                    <ui:LogMessage DisplayName="Log request failed" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Error" Message="[$&quot;MusicBrainz release lookup failed ({exception.GetType().Name}): {System.Text.RegularExpressions.Regex.Replace(If(exception.Message, String.Empty), &quot;(?i)(authorization|apikey|api_key|bearer|password|secret)([\s&quot;&quot;':=]+)[^\s&quot;&quot;',;}]+&quot;, &quot;$1$2***&quot;)}&quot;]" />
