  <Sequence sap2010:Annotation.AnnotationText="Fetches all releases of one release group from MusicBrainz (browse /ws/2/release?release-group=&lt;id&gt;&amp;inc=media), 100 per page.&#xA;Throttle: waits until 1.1 s after io_LastRequestUtc before EVERY page and updates it after every page, also on failure (same rule as ValidateAlbum). The HTTP activity's own retries (Basic policy) wait at least 1.1 s or the server's Retry-After.&#xA;Any request failure or non-2xx status throws a System exception: technical, retryable by the queue.&#xA;Not filtered by status in the URL; ChooseRelease keeps only Official releases." DisplayName="MusicBrainz Get Release Group Releases" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Default="https://musicbrainz.org/ws/2/release" Name="BaseUrl" />
      <Variable x:TypeArguments="x:TimeSpan" Default="[TimeSpan.FromMilliseconds(1100)]" Name="MinInterval" />
      <Variable x:TypeArguments="x:Int32" Default="100" Name="PageSize" />
      <Variable x:TypeArguments="x:Int32" Name="Offset" />
      <Variable x:TypeArguments="x:Int32" Name="Page" />
      <Variable x:TypeArguments="x:Int32" Name="Returned" />
      <Variable x:TypeArguments="x:Int32" Name="Total" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
