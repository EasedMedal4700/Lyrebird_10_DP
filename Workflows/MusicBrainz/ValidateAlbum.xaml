                    <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_13">
                      <Assign x:TypeArguments="x:String" DisplayName="Assign out_Status not_found" sap2010:WorkflowViewState.IdRef="Assign_26" To="[out_Status]" Value="not_found" />
                      <Assign x:TypeArguments="x:String" DisplayName="Assign out_Message" sap2010:WorkflowViewState.IdRef="Assign_27" To="[out_Message]" Value="No release group found on MusicBrainz." />
                    </Sequence>
                  </If.Then>
                  <If.Else>
                    <Sequence DisplayName="Else" sap2010:WorkflowViewState.IdRef="Sequence_14">
                      <Sequence.Variables>
                        <Variable x:TypeArguments="scg:List(njl:JToken)" Name="Candidates" />
                        <Variable x:TypeArguments="njl:JToken" Name="Best" />
                      </Sequence.Variables>
                      <Assign x:TypeArguments="scg:List(njl:JToken)" sap2010:Annotation.AnnotationText="Score &gt;= MinScore AND normalised title = album AND normalised artist credit (full credit, first artist name or first credited name) = artist." DisplayName="Assign Candidates" sap2010:WorkflowViewState.IdRef="Assign_28" To="[Candidates]" Value="[ReleaseGroups.Where(Function(rg) rg.Value(Of Integer)(&quot;score&quot;) &gt;= MinScore AndAlso Normalize(rg.Value(Of String)(&quot;title&quot;)) = Normalize(in_Album) AndAlso {String.Concat(rg(&quot;artist-credit&quot;).Select(Function(c) c.Value(Of String)(&quot;name&quot;) &amp; c.Value(Of String)(&quot;joinphrase&quot;))), rg(&quot;artist-credit&quot;)(0)(&quot;artist&quot;).Value(Of String)(&quot;name&quot;), rg(&quot;artist-credit&quot;)(0).Value(Of String)(&quot;name&quot;)}.Any(Function(n) Normalize(n) = Normalize(in_Artist))).ToList()]" />
                      <Assign x:TypeArguments="scg:List(njl:JToken)" sap2010:Annotation.AnnotationText="When several release groups match, keep only primary type Album (if any) before deciding it is ambiguous." DisplayName="Assign Candidates prefer albums" sap2010:WorkflowViewState.IdRef="Assign_29" To="[Candidates]" Value="[If(Candidates.Count &gt; 1 AndAlso Candidates.Any(Function(rg) rg.Value(Of String)(&quot;primary-type&quot;) = &quot;Album&quot;), Candidates.Where(Function(rg) rg.Value(Of String)(&quot;primary-type&quot;) = &quot;Album&quot;).ToList(), Candidates)]" />
                      <ui:LogMessage DisplayName="Log candidates" sap2010:WorkflowViewState.IdRef="LogMessage_10" Level="Info" Message="[$&quot;MusicBrainz: {Candidates.Count} release group(s) pass score &gt;= {MinScore} and the artist/album name check.&quot;]" />
                      <Assign x:TypeArguments="njl:JToken" DisplayName="Assign Best" sap2010:WorkflowViewState.IdRef="Assign_30" To="[Best]" Value="[If(Candidates.Count &gt; 0, Candidates(0), ReleaseGroups(0))]" />
                      <Assign x:TypeArguments="x:String" DisplayName="Assign out_Status" sap2010:WorkflowViewState.IdRef="Assign_31" To="[out_Status]" Value="[If(Candidates.Count = 1, &quot;validated&quot;, &quot;check_spelling&quot;)]" />
                      <Assign x:TypeArguments="x:Boolean" DisplayName="Assign out_IsAmbiguous" sap2010:WorkflowViewState.IdRef="Assign_32" To="[out_IsAmbiguous]" Value="[Candidates.Count &gt; 1]" />
                      <Assign x:TypeArguments="x:String" DisplayName="Assign out_Artist" sap2010:WorkflowViewState.IdRef="Assign_33" To="[out_Artist]" Value="[String.Concat(Best(&quot;artist-credit&quot;).Select(Function(c) c.Value(Of String)(&quot;name&quot;) &amp; c.Value(Of String)(&quot;joinphrase&quot;)))]" />
                      <Assign x:TypeArguments="x:String" DisplayName="Assign out_Album" sap2010:WorkflowViewState.IdRef="Assign_34" To="[out_Album]" Value="[Best.Value(Of String)(&quot;title&quot;)]" />
                      <Assign x:TypeArguments="x:String" DisplayName="Assign out_ArtistMbid" sap2010:WorkflowViewState.IdRef="Assign_35" To="[out_ArtistMbid]" Value="[Best(&quot;artist-credit&quot;)(0)(&quot;artist&quot;).Value(Of String)(&quot;id&quot;)]" />
                      <Assign x:TypeArguments="x:String" DisplayName="Assign out_ReleaseGroupMbid" sap2010:WorkflowViewState.IdRef="Assign_36" To="[out_ReleaseGroupMbid]" Value="[Best.Value(Of String)(&quot;id&quot;)]" />
                      <Assign x:TypeArguments="x:Int32" DisplayName="Assign out_Score" sap2010:WorkflowViewState.IdRef="Assign_37" To="[out_Score]" Value="[Best.Value(Of Integer)(&quot;score&quot;)]" />
                      <Assign x:TypeArguments="x:String" DisplayName="Assign out_Message" sap2010:WorkflowViewState.IdRef="Assign_38" To="[out_Message]" Value="[If(out_IsAmbiguous, $&quot;Ambiguous: {Candidates.Count} release groups match: &quot; &amp; String.Join(&quot;; &quot;, Candidates.Take(5).Select(Function(rg) $&quot;{rg.Value(Of String)(&quot;title&quot;)} [{rg.Value(Of String)(&quot;primary-type&quot;)}, {rg.Value(Of String)(&quot;first-release-date&quot;)}, {rg.Value(Of String)(&quot;id&quot;)}]&quot;)), If(out_Status = &quot;validated&quot;, If(out_Artist = in_Artist.Trim() AndAlso out_Album = in_Album.Trim(), &quot;Exact match.&quot;, &quot;Matched; names corrected to MusicBrainz spelling.&quot;), If(out_Score &lt; MinScore, $&quot;Best match scores {out_Score} (below {MinScore}).&quot;, &quot;Best match has a different artist or album name.&quot;) &amp; &quot; Please check the spelling.&quot;))]" />
                    </Sequence>
                  </If.Else>
                </If>
              </Sequence>
            </If.Then>
          </If>
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>