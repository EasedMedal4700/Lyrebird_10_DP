<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_Wishlist_RunValidateBatch" this:Workflows_Wishlist_RunValidateBatch.in_ValidateQueueName="Lyrebird_Validate" this:Workflows_Wishlist_RunValidateBatch.in_WishlistQueueName="Lyrebird_Wishlist" this:Workflows_Wishlist_RunValidateBatch.in_QueueFolder="Lyrebird" this:Workflows_Wishlist_RunValidateBatch.in_MaxItems="1" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:this="clr-namespace:" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
