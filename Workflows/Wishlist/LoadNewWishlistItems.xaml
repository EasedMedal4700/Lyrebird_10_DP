            <Assign x:TypeArguments="x:Boolean" sap2010:Annotation.AnnotationText="HashSet.Add returns False when the Reference was already seen in this batch. Invalid rows have an empty Reference and are never added." DisplayName="Assign IsNewInBatch" sap2010:WorkflowViewState.IdRef="Assign_11" To="[IsNewInBatch]" Value="[IsValid AndAlso SeenReferences.Add(Reference)]" />
