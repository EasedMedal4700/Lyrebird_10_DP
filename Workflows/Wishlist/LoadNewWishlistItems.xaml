            <Assign x:TypeArguments="x:String" DisplayName="Assign ItemText" sap2010:WorkflowViewState.IdRef="Assign_13" To="[ItemText]" Value="[If(IsValid, $&quot;{Reference} ('{ItemInformation(&quot;Artist&quot;)}' - '{ItemInformation(&quot;Album&quot;)}', {ItemInformation(&quot;PreferredFormat&quot;)})&quot;, $&quot;row {RowIndex + 1}/{Rows.Count}&quot;)]" />
            <Switch x:TypeArguments="x:String" DisplayName="Switch on Action" Expression="[Action]" sap2010:WorkflowViewState.IdRef="Switch`1_1">
              <Switch.Default>
                <Sequence DisplayName="Default" sap2010:WorkflowViewState.IdRef="Sequence_6">
