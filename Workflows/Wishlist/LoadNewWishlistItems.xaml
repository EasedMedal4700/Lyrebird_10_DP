              <Sequence x:Key="invalid" DisplayName="invalid" sap2010:WorkflowViewState.IdRef="Sequence_7">
                <Assign x:TypeArguments="x:Int32" DisplayName="Increment out_InvalidCount" sap2010:WorkflowViewState.IdRef="Assign_14" To="[out_InvalidCount]" Value="[out_InvalidCount + 1]" />
                <ui:LogMessage DisplayName="Log invalid row" sap2010:WorkflowViewState.IdRef="LogMessage_4" Level="Warn" Message="[$&quot;Load wishlist: {ItemText} SKIPPED (invalid): {InvalidReason}. Row: {If(row Is Nothing, &quot;null&quot;, row.ToString(Newtonsoft.Json.Formatting.None))}&quot;]" />
              </Sequence>
              <Sequence x:Key="duplicate_in_batch" DisplayName="duplicate_in_batch" sap2010:WorkflowViewState.IdRef="Sequence_8">
