                <ui:LogMessage DisplayName="Log duplicate in batch" sap2010:WorkflowViewState.IdRef="LogMessage_5" Level="Warn" Message="[$&quot;Load wishlist: {ItemText} SKIPPED (duplicate in this batch).&quot;]" />
