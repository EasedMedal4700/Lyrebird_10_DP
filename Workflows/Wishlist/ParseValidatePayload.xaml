      <Assign x:TypeArguments="x:String" DisplayName="Assign out_Album" sap2010:WorkflowViewState.IdRef="Assign_9" To="[out_Album]" Value="[GetField(&quot;Album&quot;)]" />
      <Assign x:TypeArguments="x:String" DisplayName="Assign out_PreferredFormat" sap2010:WorkflowViewState.IdRef="Assign_10" To="[out_PreferredFormat]" Value="[GetField(&quot;PreferredFormat&quot;).ToUpperInvariant()]" />
      <Assign x:TypeArguments="x:String" DisplayName="Assign ExpectedReference" sap2010:WorkflowViewState.IdRef="Assign_11" To="[ExpectedReference]" Value="[$&quot;WL-{out_WishlistId}-S{out_Submission}&quot;]" />
    </Sequence>
    <Assign x:TypeArguments="x:String" DisplayName="Assign out_InvalidReason" sap2010:WorkflowViewState.IdRef="Assign_12" To="[out_InvalidReason]" Value="[String.Join(&quot;; &quot;, {If(in_SpecificContent Is Nothing, &quot;specific content is missing&quot;, Nothing), If(out_PayloadVersion = 1, Nothing, $&quot;PayloadVersion '{VersionText}' is not supported (expected 1)&quot;), If(out_WishlistId &gt; 0, Nothing, $&quot;WishlistId '{IdText}' is not a positive integer&quot;), If(out_Submission &gt;= 1, Nothing, $&quot;Submission '{SubmissionText}' is not a positive integer&quot;), If(out_Artist = String.Empty, &quot;Artist is empty&quot;, Nothing), If(out_Album = String.Empty, &quot;Album is empty&quot;, Nothing), If({&quot;FLAC&quot;, &quot;MP3&quot;, &quot;ANY&quot;}.Contains(out_PreferredFormat), Nothing, $&quot;PreferredFormat '{out_PreferredFormat}' is not FLAC, MP3 or ANY&quot;), If(String.IsNullOrWhiteSpace(in_Reference) OrElse out_WishlistId &lt;= 0 OrElse out_Submission &lt; 1 OrElse String.Equals(in_Reference.Trim(), ExpectedReference, StringComparison.OrdinalIgnoreCase), Nothing, $&quot;Reference '{in_Reference}' does not match payload ({ExpectedReference})&quot;)}.Where(Function(m) m IsNot Nothing))]" />
