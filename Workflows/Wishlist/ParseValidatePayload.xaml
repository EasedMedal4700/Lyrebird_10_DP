  <Sequence sap2010:Annotation.AnnotationText="Validates the specific content of one Lyrebird_Validate queue item (contract: Documentation/Lyrebird_DataContract.md).&#xA;No side effects. Keys are matched case-insensitively; numbers are accepted as numbers or numeric strings.&#xA;Only PayloadVersion 1 is supported." DisplayName="Parse Validate Payload" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="s:Func(x:String, x:String)" Name="GetField" />
      <Variable x:TypeArguments="x:String" Name="VersionText" />
      <Variable x:TypeArguments="x:String" Name="IdText" />
