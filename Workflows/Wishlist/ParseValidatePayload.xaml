    <Assign x:TypeArguments="s:Func(x:String, x:String)" sap2010:Annotation.AnnotationText="Case-insensitive key lookup; missing key or null value = empty string." DisplayName="Assign GetField" sap2010:WorkflowViewState.IdRef="Assign_1" To="[GetField]" Value="[Function(k As String) If(in_SpecificContent Is Nothing, String.Empty, If(in_SpecificContent.Where(Function(kv) String.Equals(kv.Key, k, StringComparison.OrdinalIgnoreCase)).Select(Function(kv) If(kv.Value Is Nothing, String.Empty, kv.Value.ToString())).FirstOrDefault(), String.Empty).Trim())]" />
    <Sequence DisplayName="Read fields" sap2010:WorkflowViewState.IdRef="Sequence_2">
      <Assign x:TypeArguments="x:String" DisplayName="Assign VersionText" sap2010:WorkflowViewState.IdRef="Assign_2" To="[VersionText]" Value="[GetField(&quot;PayloadVersion&quot;)]" />
      <Assign x:TypeArguments="x:String" DisplayName="Assign IdText" sap2010:WorkflowViewState.IdRef="Assign_3" To="[IdText]" Value="[GetField(&quot;WishlistId&quot;)]" />
      <Assign x:TypeArguments="x:String" DisplayName="Assign SubmissionText" sap2010:WorkflowViewState.IdRef="Assign_4" To="[SubmissionText]" Value="[GetField(&quot;Submission&quot;)]" />
      <Assign x:TypeArguments="x:Int32" DisplayName="Assign out_PayloadVersion" sap2010:WorkflowViewState.IdRef="Assign_5" To="[out_PayloadVersion]" Value="[If(Regex.IsMatch(VersionText, &quot;^[0-9]{1,6}$&quot;), CInt(VersionText), 0)]" />
      <Assign x:TypeArguments="x:Int64" DisplayName="Assign out_WishlistId" sap2010:WorkflowViewState.IdRef="Assign_6" To="[out_WishlistId]" Value="[If(Regex.IsMatch(IdText, &quot;^[0-9]{1,18}$&quot;), CLng(IdText), 0L)]" />
