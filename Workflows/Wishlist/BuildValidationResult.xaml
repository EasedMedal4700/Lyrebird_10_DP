    <x:Property sap2010:Annotation.AnnotationText="True when the row has an mb_artist_id column (proposed migration)." Name="in_HasArtistIdColumn" Type="InArgument(x:Boolean)" />
    <x:Property sap2010:Annotation.AnnotationText="True when the row has the reserved_release_group column: the PATCH then keeps the reservation for 'queued' and releases it (NULL) for every other outcome." Name="in_HasReservationColumn" Type="InArgument(x:Boolean)" />
