  <Sequence sap2010:Annotation.AnnotationText="Turns a validation result into what has to be written. No side effects.&#xA;Only existing wishlist statuses are written: queued, check_spelling, not_found, failed.&#xA;- needs_release_choice is stored as check_spelling with a 'RELEASE_CHOICE:' message.&#xA;- duplicate_release is stored as failed with a 'DUPLICATE:' message.&#xA;(proposed dedicated statuses: Documentation/Migration_Proposal_Part2.sql)&#xA;A technical MusicBrainz failure (api_error) is NEVER written: it throws a System exception so the queue retries the item." DisplayName="Build Validation Result" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="ScoreLabel" />
      <Variable x:TypeArguments="x:Boolean" Name="GroupValidated" />
      <Variable x:TypeArguments="x:String" Default="^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" Name="UuidPattern" />
      <Variable x:TypeArguments="scg:List(njl:JProperty)" Name="Props" />
      <Variable x:TypeArguments="njl:JObject" Name="V" />
      <Variable x:TypeArguments="x:String" Name="ValidateStatus" />
      <Variable x:TypeArguments="x:String" Name="ValidateMessage" />
      <Variable x:TypeArguments="x:String" Name="MbArtist" />
      <Variable x:TypeArguments="x:String" Name="MbAlbum" />
      <Variable x:TypeArguments="x:String" Name="ArtistMbid" />
