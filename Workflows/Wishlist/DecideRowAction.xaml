<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_Wishlist_DecideRowAction" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:njl="clr-namespace:Newtonsoft.Json.Linq;assembly=Newtonsoft.Json" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property sap2010:Annotation.AnnotationText="WishlistId from the queue payload." Name="in_WishlistId" Type="InArgument(x:Int64)" />
    <x:Property sap2010:Annotation.AnnotationText="Submission from the queue payload." Name="in_Submission" Type="InArgument(x:Int32)" />
    <x:Property sap2010:Annotation.AnnotationText="The wishlist row read with select=* (Nothing when Supabase returned no row)." Name="in_Row" Type="InArgument(njl:JToken)" />
    <x:Property sap2010:Annotation.AnnotationText="process | already_completed | stale_submission | submission_ahead | missing_row | unexpected_status" Name="out_Action" Type="OutArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Human-readable explanation of the action." Name="out_Reason" Type="OutArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Current status of the row (empty when missing)." Name="out_RowStatus" Type="OutArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Current submission of the row; 1 when the column does not exist or is null." Name="out_RowSubmission" Type="OutArgument(x:Int32)" />
    <x:Property sap2010:Annotation.AnnotationText="True when the row has a 'submission' column (proposed migration). Updates then also filter on it." Name="out_HasSubmissionColumn" Type="OutArgument(x:Boolean)" />
    <x:Property sap2010:Annotation.AnnotationText="True when the row has an 'mb_release_id' column (proposed migration)." Name="out_HasReleaseIdColumn" Type="OutArgument(x:Boolean)" />
    <x:Property sap2010:Annotation.AnnotationText="True when the row has an 'mb_artist_id' column (proposed migration)." Name="out_HasArtistIdColumn" Type="OutArgument(x:Boolean)" />
    <x:Property sap2010:Annotation.AnnotationText="Exact text of updated_at, read as 'row_version:updated_at::text' (empty when the row was read without it). Used as an optimistic-concurrency guard: any edit changes it." Name="out_RowVersion" Type="OutArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="True when the row has a 'reserved_release_group' column (album reservation, migration 2026-10-07_01)." Name="out_HasReservationColumn" Type="OutArgument(x:Boolean)" />
    <x:Property sap2010:Annotation.AnnotationText="Release group this row currently reserves (empty = none)." Name="out_ReservedReleaseGroup" Type="OutArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="chosen_release_id set by a person (empty = none)." Name="out_ChosenReleaseId" Type="OutArgument(x:String)" />
  </x:Members>
