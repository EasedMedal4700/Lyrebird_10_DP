<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_Wishlist_BuildValidateQueueItem" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:njl="clr-namespace:Newtonsoft.Json.Linq;assembly=Newtonsoft.Json" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property sap2010:Annotation.AnnotationText="One wishlist row as returned by Supabase GetRows (JSON object with at least id, artist, album, preferred_format; submission is optional and defaults to 1)." Name="in_Row" Type="InArgument(njl:JToken)" />
    <x:Property sap2010:Annotation.AnnotationText="Queue item Reference '&lt;artist&gt; - &lt;album&gt; | WL-&lt;id&gt;-S&lt;submission&gt;' (BuildQueueReference): the row's queue_reference when it belongs to this submission, otherwise a new one. Empty when the row is invalid." Name="out_Reference" Type="OutArgument(x:String)" />
