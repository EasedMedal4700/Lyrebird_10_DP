  <Sequence sap2010:Annotation.AnnotationText="Turns one wishlist row into the Reference and specific content of a Lyrebird_Validate queue item.&#xA;No side effects (no Supabase, no Orchestrator), so it can be tested offline.&#xA;The Reference is readable ('&lt;artist&gt; - &lt;album&gt; | WL-&lt;id&gt;-S&lt;submission&gt;') but is fixed once per submission: when the row already holds a queue_reference for this submission it is reused unchanged, so a spelling fix without resubmission never creates a second queue item." DisplayName="Build Validate Queue Item" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="njl:JObject" Name="Row" />
      <Variable x:TypeArguments="x:String" Name="IdText" />
      <Variable x:TypeArguments="x:Int64" Name="WishlistId" />
      <Variable x:TypeArguments="x:String" Name="Artist" />
      <Variable x:TypeArguments="x:String" Name="Album" />
      <Variable x:TypeArguments="x:String" Name="PreferredFormat" />
      <Variable x:TypeArguments="x:String" Name="SubmissionText" />
      <Variable x:TypeArguments="x:Int32" Name="Submission" />
      <Variable x:TypeArguments="x:String" Name="StoredReference" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <Sequence DisplayName="Reset outputs" sap2010:WorkflowViewState.IdRef="Sequence_2">
      <Assign x:TypeArguments="x:Boolean" DisplayName="Assign out_IsValid" sap2010:WorkflowViewState.IdRef="Assign_1" To="[out_IsValid]" Value="[False]" />
      <Assign x:TypeArguments="x:String" DisplayName="Assign out_Reference" sap2010:WorkflowViewState.IdRef="Assign_2" To="[out_Reference]" Value="[String.Empty]" />
      <Assign x:TypeArguments="x:Boolean" DisplayName="Assign out_ReferenceIsStored" sap2010:WorkflowViewState.IdRef="Assign_16" To="[out_ReferenceIsStored]" Value="[False]" />
      <Assign x:TypeArguments="scg:Dictionary(x:String, x:Object)" DisplayName="Assign out_ItemInformation" sap2010:WorkflowViewState.IdRef="Assign_3" To="[out_ItemInformation]" Value="[New Dictionary(Of String, Object)()]" />
    </Sequence>
    <Sequence DisplayName="Read row fields" sap2010:WorkflowViewState.IdRef="Sequence_3">
      <Assign x:TypeArguments="njl:JObject" sap2010:Annotation.AnnotationText="Anything that is not a JSON object becomes an empty object, so every field below reads as missing." DisplayName="Assign Row" sap2010:WorkflowViewState.IdRef="Assign_4" To="[Row]" Value="[If(TryCast(in_Row, JObject), New JObject())]" />
      <Assign x:TypeArguments="x:String" DisplayName="Assign IdText" sap2010:WorkflowViewState.IdRef="Assign_5" To="[IdText]" Value="[If(Row.Value(Of String)(&quot;id&quot;), String.Empty).Trim()]" />
      <Assign x:TypeArguments="x:Int64" DisplayName="Assign WishlistId" sap2010:WorkflowViewState.IdRef="Assign_6" To="[WishlistId]" Value="[If(Regex.IsMatch(IdText, &quot;^[0-9]{1,18}$&quot;), CLng(IdText), 0L)]" />
      <Assign x:TypeArguments="x:String" DisplayName="Assign Artist" sap2010:WorkflowViewState.IdRef="Assign_7" To="[Artist]" Value="[If(Row.Value(Of String)(&quot;artist&quot;), String.Empty).Trim()]" />
      <Assign x:TypeArguments="x:String" DisplayName="Assign Album" sap2010:WorkflowViewState.IdRef="Assign_8" To="[Album]" Value="[If(Row.Value(Of String)(&quot;album&quot;), String.Empty).Trim()]" />
      <Assign x:TypeArguments="x:String" DisplayName="Assign PreferredFormat" sap2010:WorkflowViewState.IdRef="Assign_9" To="[PreferredFormat]" Value="[If(Row.Value(Of String)(&quot;preferred_format&quot;), String.Empty).Trim().ToUpperInvariant()]" />
      <Assign x:TypeArguments="x:String" DisplayName="Assign StoredReference" sap2010:WorkflowViewState.IdRef="Assign_17" To="[StoredReference]" Value="[If(Row.Value(Of String)(&quot;queue_reference&quot;), String.Empty)]" />
      <Assign x:TypeArguments="x:String" sap2010:Annotation.AnnotationText="Missing or null submission = first submission." DisplayName="Assign SubmissionText" sap2010:WorkflowViewState.IdRef="Assign_10" To="[SubmissionText]" Value="[If(Row.Value(Of String)(&quot;submission&quot;), String.Empty).Trim()]" />
      <Assign x:TypeArguments="x:Int32" DisplayName="Assign Submission" sap2010:WorkflowViewState.IdRef="Assign_11" To="[Submission]" Value="[If(SubmissionText = String.Empty, 1, If(Regex.IsMatch(SubmissionText, &quot;^[0-9]{1,6}$&quot;), CInt(SubmissionText), 0))]" />
    </Sequence>
    <Assign x:TypeArguments="x:String" DisplayName="Assign out_InvalidReason" sap2010:WorkflowViewState.IdRef="Assign_12" To="[out_InvalidReason]" Value="[String.Join(&quot;; &quot;, {If(in_Row Is Nothing OrElse TryCast(in_Row, JObject) Is Nothing, &quot;row is not a JSON object&quot;, Nothing), If(WishlistId &lt;= 0, $&quot;id '{IdText}' is not a positive integer&quot;, Nothing), If(Artist = String.Empty, &quot;artist is empty&quot;, Nothing), If(Album = String.Empty, &quot;album is empty&quot;, Nothing), If(PreferredFormat = String.Empty, &quot;preferred_format is missing (include it in the select)&quot;, If({&quot;FLAC&quot;, &quot;MP3&quot;, &quot;ANY&quot;}.Contains(PreferredFormat), Nothing, $&quot;preferred_format '{PreferredFormat}' is not FLAC, MP3 or ANY&quot;)), If(Submission &lt; 1, $&quot;submission '{SubmissionText}' is not a positive integer&quot;, Nothing)}.Where(Function(m) m IsNot Nothing))]" />
    <If Condition="[out_InvalidReason = String.Empty]" DisplayName="If row is valid" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_4">
          <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Invoke BuildQueueReference" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Workflows\Wishlist\BuildQueueReference.xaml">
            <ui:InvokeWorkflowFile.Arguments>
              <InArgument x:TypeArguments="x:String" x:Key="in_Artist">[Artist]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_Album">[Album]</InArgument>
              <InArgument x:TypeArguments="x:Int64" x:Key="in_WishlistId">[WishlistId]</InArgument>
              <InArgument x:TypeArguments="x:Int32" x:Key="in_Submission">[Submission]</InArgument>
              <InArgument x:TypeArguments="x:String" x:Key="in_StoredReference">[StoredReference]</InArgument>
              <OutArgument x:TypeArguments="x:String" x:Key="out_Reference">[out_Reference]</OutArgument>
              <OutArgument x:TypeArguments="x:Boolean" x:Key="out_IsStored">[out_ReferenceIsStored]</OutArgument>
            </ui:InvokeWorkflowFile.Arguments>
          </ui:InvokeWorkflowFile>
          <Assign x:TypeArguments="scg:Dictionary(x:String, x:Object)" DisplayName="Assign out_ItemInformation" sap2010:WorkflowViewState.IdRef="Assign_14" To="[out_ItemInformation]" Value="[New Dictionary(Of String, Object) From {{&quot;PayloadVersion&quot;, 1}, {&quot;WishlistId&quot;, WishlistId}, {&quot;Artist&quot;, Artist}, {&quot;Album&quot;, Album}, {&quot;PreferredFormat&quot;, PreferredFormat}, {&quot;Submission&quot;, Submission}}]" />
          <Assign x:TypeArguments="x:Boolean" DisplayName="Assign out_IsValid" sap2010:WorkflowViewState.IdRef="Assign_15" To="[out_IsValid]" Value="[True]" />
        </Sequence>
      </If.Then>
    </If>
  </Sequence>
