    <Assign x:TypeArguments="x:String" DisplayName="Assign out_Message" sap2010:WorkflowViewState.IdRef="Assign_2" To="[out_Message]" Value="[If(out_Result = &quot;superseded&quot;, $&quot;{in_Context} not written: {Reason} Nothing was overwritten; the newer submission will be processed.&quot;, If(out_Result = &quot;already_persisted&quot;, $&quot;{in_Context}: row is already '{RowStatus}' for this submission (earlier attempt).&quot;, If(Action = &quot;process&quot;, $&quot;{in_Context} not written: wishlist row {in_WishlistId} was edited while it was being validated. Nothing was overwritten. Resubmit (submission + 1) so the new input is validated.&quot;, $&quot;{in_Context} not written: {Reason} Nothing was overwritten.&quot;)))]" />
