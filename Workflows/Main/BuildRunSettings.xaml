<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_Main_BuildRunSettings" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property sap2010:Annotation.AnnotationText="Input queue Main consumes (Config OrchestratorQueueName or argument in_OrchestratorQueueName)." Name="in_ValidateQueueName" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Output queue for validated albums (Config WishlistQueueName or argument in_WishlistQueueName)." Name="in_WishlistQueueName" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Optional extra PostgREST filter for the startup load, e.g. 'id=in.(40,41)'. Only conditions on id, artist, album, preferred_format or submission are accepted, so the safety filters cannot be overridden." Name="in_LoadFilter" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Optional test-only failure injection for the performer (after_reservation | after_enqueue). Only accepted in test mode." Name="in_TestFailAfterStep" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="True when the input queue ends with _IT (integration test run)." Name="out_TestMode" Type="OutArgument(x:Boolean)" />
    <x:Property sap2010:Annotation.AnnotationText="PostgREST query for LoadNewWishlistItems. Test mode loads ONLY rows whose message starts with LYREBIRD_IT; production mode loads ONLY rows without that marker." Name="out_LoadQuery" Type="OutArgument(x:String)" />
  </x:Members>
