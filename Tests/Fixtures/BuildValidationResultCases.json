{
  "base": {
    "wishlistId": 42, "submission": 1, "preferredFormat": "FLAC",
    "validateStatus": "validated", "validateMessage": "Exact match.",
    "mbArtist": "Radiohead", "mbAlbum": "OK Computer",
    "artistMbid": "a74b1b7f-71a5-4011-9441-d0b5e4122711",
    "releaseGroupMbid": "b1392450-e666-3926-a536-22c65f834433",
    "score": 100,
    "releaseId": "0b6b4ba0-d36f-47bd-b4ea-6a5b91842d29", "trackCount": 12,
    "releaseAmbiguous": false, "releaseReason": "Chose the earliest official release.",
    "duplicateOf": 0, "hasReleaseIdColumn": false, "hasArtistIdColumn": false, "hasReservationColumn": false, "alreadyEnqueued": false,
    "requestArtist": "radiohead", "requestAlbum": "ok computer", "requestPreferredFormat": "FLAC"
  },
  "cases": [
    { "name": "valid result, today's schema",
      "input": {},
      "expect": { "outcome": "queued", "dbStatus": "queued", "enqueue": true, "reference": "WL-42-S1",
                  "patchHas": [ "status", "message", "mb_artist", "mb_album", "mbid", "match_score", "track_count" ],
                  "patchHasNot": [ "mb_release_id", "mb_artist_id" ],
                  "queue": { "PayloadVersion": "1", "WishlistId": "42", "Submission": "1", "Artist": "Radiohead", "Album": "OK Computer", "PreferredFormat": "FLAC",
                             "MbReleaseGroupId": "b1392450-e666-3926-a536-22c65f834433", "MbReleaseId": "0b6b4ba0-d36f-47bd-b4ea-6a5b91842d29",
                             "MbArtistId": "a74b1b7f-71a5-4011-9441-d0b5e4122711", "TrackCount": "12",
                             "RequestArtist": "radiohead", "RequestAlbum": "ok computer", "RequestPreferredFormat": "FLAC" } } },
    { "name": "queued keeps the album reservation",
      "input": { "hasReservationColumn": true },
      "expect": { "outcome": "queued", "patchEquals": { "reserved_release_group": "b1392450-e666-3926-a536-22c65f834433" } } },
    { "name": "negative outcome releases the album reservation",
      "input": { "hasReservationColumn": true, "validateStatus": "not_found", "validateMessage": "No release group found on MusicBrainz.", "releaseGroupMbid": "", "releaseId": "", "trackCount": 0 },
      "expect": { "outcome": "not_found", "patchEquals": { "reserved_release_group": null } } },
    { "name": "duplicate album never holds the reservation",
      "input": { "hasReservationColumn": true, "duplicateOf": 7 },
      "expect": { "outcome": "duplicate_release", "enqueue": false, "patchEquals": { "reserved_release_group": null } } },
    { "name": "valid result, migrated schema writes release and artist MBIDs",
      "input": { "hasReleaseIdColumn": true, "hasArtistIdColumn": true },
      "expect": { "outcome": "queued", "patchHas": [ "mb_release_id", "mb_artist_id", "mbid" ] } },
    { "name": "release ambiguous: no release chosen, stored as check_spelling",
      "input": { "releaseAmbiguous": true, "releaseId": "", "trackCount": 0, "releaseReason": "Earliest official releases (1997) differ in track count (12/13)." },
      "expect": { "outcome": "needs_release_choice", "dbStatus": "check_spelling", "enqueue": false, "messageStartsWith": "RELEASE_CHOICE:",
                  "patchHas": [ "mbid", "mb_artist" ], "patchHasNot": [ "track_count", "mb_release_id" ] } },
    { "name": "no match on MusicBrainz",
      "input": { "validateStatus": "not_found", "validateMessage": "No release group found on MusicBrainz.", "mbArtist": "", "mbAlbum": "", "artistMbid": "", "releaseGroupMbid": "", "score": 0, "releaseId": "", "trackCount": 0 },
      "expect": { "outcome": "not_found", "dbStatus": "not_found", "enqueue": false, "messageContains": "No release group found",
                  "patchHasNot": [ "mb_artist", "mbid", "match_score", "track_count" ] } },
    { "name": "spelling or ambiguous release group: suggestion only in the message",
      "input": { "validateStatus": "check_spelling", "validateMessage": "Ambiguous: 2 release groups match.", "score": 95, "releaseId": "", "trackCount": 0 },
      "expect": { "outcome": "check_spelling", "dbStatus": "check_spelling", "enqueue": false, "messageContains": "Closest MusicBrainz match: 'Radiohead' - 'OK Computer'",
                  "patchHasNot": [ "mb_artist", "mb_album", "mbid", "match_score" ] } },
    { "name": "same album already queued by another row",
      "input": { "duplicateOf": 7 },
      "expect": { "outcome": "duplicate_release", "dbStatus": "failed", "enqueue": false, "messageStartsWith": "DUPLICATE:", "messageContains": "wishlist row 7",
                  "patchHasNot": [ "track_count" ] } },
    { "name": "recovery after partial completion: item exists, only persist",
      "input": { "alreadyEnqueued": true, "score": -1 },
      "expect": { "outcome": "queued", "dbStatus": "queued", "enqueue": false, "messageContains": "Recovered",
                  "patchHas": [ "track_count", "mbid" ], "patchHasNot": [ "match_score" ] } },
    { "name": "transient MusicBrainz failure is retryable, never stored",
      "input": { "validateStatus": "api_error", "validateMessage": "MusicBrainz returned HTTP 503" },
      "expect": { "exception": "Exception" } },
    { "name": "unknown validation status is treated as technical",
      "input": { "validateStatus": "" },
      "expect": { "exception": "Exception" } },
    { "name": "invalid MBIDs are never written or enqueued",
      "input": { "releaseGroupMbid": "not-a-uuid", "hasReleaseIdColumn": true, "releaseId": "also-not-a-uuid" },
      "expect": { "outcome": "needs_release_choice", "dbStatus": "check_spelling", "enqueue": false, "patchHasNot": [ "mbid", "mb_release_id", "track_count" ] } },
    { "name": "valid group but invalid release MBID is not enqueued",
      "input": { "releaseId": "rel-a1" },
      "expect": { "outcome": "needs_release_choice", "enqueue": false, "patchHas": [ "mbid" ], "patchHasNot": [ "track_count" ] } }
  ]
}
