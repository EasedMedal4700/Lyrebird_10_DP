[
  { "name": "new row, no submission column (today's schema)", "wishlistId": 42, "submission": 1,
    "row": { "id": 42, "artist": "Radiohead", "album": "OK Computer", "status": "new" },
    "expect": { "action": "process", "hasSubmissionColumn": false, "rowSubmission": 1, "hasReleaseIdColumn": false } },
  { "name": "new row, same submission (migrated schema)", "wishlistId": 42, "submission": 2,
    "row": { "id": 42, "status": "new", "submission": 2 },
    "expect": { "action": "process", "hasSubmissionColumn": true, "rowSubmission": 2 } },
  { "name": "null submission counts as 1", "wishlistId": 42, "submission": 1,
    "row": { "id": 42, "status": "new", "submission": null },
    "expect": { "action": "process", "hasSubmissionColumn": true, "rowSubmission": 1 } },
  { "name": "stale: row was resubmitted after this item was loaded", "wishlistId": 42, "submission": 1,
    "row": { "id": 42, "status": "new", "submission": 2 },
    "expect": { "action": "stale_submission" } },
  { "name": "stale wins over status: newer submission already queued", "wishlistId": 42, "submission": 1,
    "row": { "id": 42, "status": "queued", "submission": 3 },
    "expect": { "action": "stale_submission" } },
  { "name": "item ahead of the row (inconsistent)", "wishlistId": 42, "submission": 3,
    "row": { "id": 42, "status": "new", "submission": 2 },
    "expect": { "action": "submission_ahead" } },
  { "name": "retry after the update already succeeded (queued)", "wishlistId": 42, "submission": 2,
    "row": { "id": 42, "status": "queued", "submission": 2 },
    "expect": { "action": "already_completed", "rowStatus": "queued" } },
  { "name": "retry after a negative result was stored", "wishlistId": 42, "submission": 1,
    "row": { "id": 42, "status": "check_spelling" },
    "expect": { "action": "already_completed", "rowStatus": "check_spelling" } },
  { "name": "failed row is not retried without resubmission", "wishlistId": 42, "submission": 1,
    "row": { "id": 42, "status": "failed" },
    "expect": { "action": "already_completed" } },
  { "name": "missing row", "wishlistId": 42, "submission": 1, "row": null,
    "expect": { "action": "missing_row" } },
  { "name": "row with another id", "wishlistId": 42, "submission": 1,
    "row": { "id": 43, "status": "new" },
    "expect": { "action": "missing_row" } },
  { "name": "status unknown to this process", "wishlistId": 42, "submission": 1,
    "row": { "id": 42, "status": "validating" },
    "expect": { "action": "unexpected_status" } },
  { "name": "row version, reservation and chosen release are passed through", "wishlistId": 42, "submission": 2,
    "row": { "id": 42, "status": "new", "submission": 2, "row_version": "2026-10-07 10:55:01.123456+00", "reserved_release_group": "b1392450-e666-3926-a536-22c65f834433", "chosen_release_id": "0b6b4ba0-d36f-47bd-b4ea-6a5b91842d29" },
    "expect": { "action": "process", "rowVersion": "2026-10-07 10:55:01.123456+00", "hasReservationColumn": true, "reservedReleaseGroup": "b1392450-e666-3926-a536-22c65f834433", "chosenReleaseId": "0b6b4ba0-d36f-47bd-b4ea-6a5b91842d29" } },
  { "name": "migration columns are detected", "wishlistId": 42, "submission": 1,
    "row": { "id": 42, "status": "new", "submission": 1, "mb_release_id": null, "mb_artist_id": null },
    "expect": { "action": "process", "hasReleaseIdColumn": true, "hasArtistIdColumn": true } }
]
