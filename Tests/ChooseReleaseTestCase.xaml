            <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_4">
              <Sequence.Variables>
                <Variable x:TypeArguments="x:String" Name="ReleaseId" />
                <Variable x:TypeArguments="x:Int32" Name="TrackCount" />
                <Variable x:TypeArguments="x:Boolean" Name="Ambiguous" />
                <Variable x:TypeArguments="x:String" Name="Reason" />
                <Variable x:TypeArguments="x:Int32" Name="CandidateCount" />
                <Variable x:TypeArguments="njl:JObject" Name="E" />
                <Variable x:TypeArguments="scg:List(x:String)" Name="Problems" />
              </Sequence.Variables>
              <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Invoke ChooseRelease" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Workflows\MusicBrainz\ChooseRelease.xaml">
                <ui:InvokeWorkflowFile.Arguments>
                  <InArgument x:TypeArguments="njl:JArray" x:Key="in_Releases">[CType(c("releases"), JArray)]</InArgument>
                  <InArgument x:TypeArguments="x:String" x:Key="in_ChosenReleaseId">[If(c.Value(Of String)("chosenReleaseId"), String.Empty)]</InArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_ReleaseId">[ReleaseId]</OutArgument>
                  <OutArgument x:TypeArguments="x:Int32" x:Key="out_TrackCount">[TrackCount]</OutArgument>
                  <OutArgument x:TypeArguments="x:Boolean" x:Key="out_IsAmbiguous">[Ambiguous]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_Reason">[Reason]</OutArgument>
                  <OutArgument x:TypeArguments="x:Int32" x:Key="out_CandidateCount">[CandidateCount]</OutArgument>
                </ui:InvokeWorkflowFile.Arguments>
              </ui:InvokeWorkflowFile>
              <Assign x:TypeArguments="njl:JObject" DisplayName="Assign E" sap2010:WorkflowViewState.IdRef="Assign_2" To="[E]" Value="[CType(c(&quot;expect&quot;), JObject)]" />
              <Assign x:TypeArguments="scg:List(x:String)" DisplayName="Assign Problems" sap2010:WorkflowViewState.IdRef="Assign_3" To="[Problems]" Value="[{If(Ambiguous &lt;&gt; E.Value(Of Boolean)(&quot;ambiguous&quot;), $&quot;ambiguous={Ambiguous} ({Reason})&quot;, Nothing), If(E(&quot;releaseId&quot;) IsNot Nothing AndAlso ReleaseId &lt;&gt; E.Value(Of String)(&quot;releaseId&quot;), $&quot;releaseId='{ReleaseId}'&quot;, Nothing), If(E(&quot;trackCount&quot;) IsNot Nothing AndAlso TrackCount &lt;&gt; E.Value(Of Integer)(&quot;trackCount&quot;), $&quot;trackCount={TrackCount}&quot;, Nothing), If(E(&quot;reasonContains&quot;) IsNot Nothing AndAlso Not If(Reason, String.Empty).Contains(E.Value(Of String)(&quot;reasonContains&quot;)), $&quot;reason lacks '{E.Value(Of String)(&quot;reasonContains&quot;)}' (reason: {Reason})&quot;, Nothing), If(Ambiguous AndAlso (ReleaseId &lt;&gt; String.Empty OrElse TrackCount &lt;&gt; 0), &quot;ambiguous result must not carry a release&quot;, Nothing)}.Where(Function(p) p IsNot Nothing).ToList()]" />
              <Assign x:TypeArguments="scg:List(x:String)" DisplayName="Collect failures" sap2010:WorkflowViewState.IdRef="Assign_4" To="[Failures]" Value="[Failures.Concat(Problems.Select(Function(p) c.Value(Of String)(&quot;name&quot;) &amp; &quot;: &quot; &amp; p)).ToList()]" />
