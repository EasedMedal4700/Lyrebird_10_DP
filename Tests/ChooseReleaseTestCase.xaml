  <Sequence sap2010:Annotation.AnnotationText="Offline: ChooseRelease (release-selection policy) against Tests/Fixtures/ChooseReleaseCases.json - original edition chosen, bonus-track ambiguity, multi-disc, no official release, no dates, empty list, no track count." DisplayName="ChooseReleaseTestCase" sap2010:WorkflowViewState.IdRef="Sequence_1">
