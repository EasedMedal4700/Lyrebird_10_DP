  <Sequence sap2010:Annotation.AnnotationText="Offline: Data/Config.xlsx as InitAllSettings reads it (no Orchestrator assets are configured in the Assets sheet). Checks the Lyrebird production settings Main.xaml relies on, and that they resolve to PRODUCTION mode in BuildRunSettings. Replaces the REFramework template checks (Config loaded, MaxRetryNumber exists)." DisplayName="InitAllSettingsTestCase" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Object)" Name="Config" />
      <Variable x:TypeArguments="s:Func(x:String, x:String)" Name="Cfg" />
      <Variable x:TypeArguments="x:Boolean" Name="TestMode" />
      <Variable x:TypeArguments="x:String" Name="LoadQuery" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="Problems" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <Sequence DisplayName="... Given / When: read the configuration" sap2010:WorkflowViewState.IdRef="Sequence_2">
      <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Invoke InitAllSettings workflow" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Framework\InitAllSettings.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <InArgument x:TypeArguments="x:String" x:Key="in_ConfigFile">Data\Config.xlsx</InArgument>
          <InArgument x:TypeArguments="s:String[]" x:Key="in_ConfigSheets">[{"Settings", "Constants"}]</InArgument>
          <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="out_Config">[Config]</OutArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
      <Assign x:TypeArguments="s:Func(x:String, x:String)" DisplayName="Assign Cfg" sap2010:WorkflowViewState.IdRef="Assign_1" To="[Cfg]" Value="[Function(k As String) If(Config IsNot Nothing AndAlso Config.ContainsKey(k), Convert.ToString(Config(k)).Trim(), &quot;&lt;missing&gt;&quot;)]" />
      <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Invoke BuildRunSettings (production config)" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2" UnSafe="False" WorkflowFileName="Workflows\Main\BuildRunSettings.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <InArgument x:TypeArguments="x:String" x:Key="in_ValidateQueueName">[Cfg("OrchestratorQueueName")]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_WishlistQueueName">[Cfg("WishlistQueueName")]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_LoadFilter">[String.Empty]</InArgument>
          <InArgument x:TypeArguments="x:String" x:Key="in_TestFailAfterStep">[String.Empty]</InArgument>
          <OutArgument x:TypeArguments="x:Boolean" x:Key="out_TestMode">[TestMode]</OutArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_LoadQuery">[LoadQuery]</OutArgument>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
    </Sequence>
    <Sequence DisplayName="... Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
      <Assign x:TypeArguments="scg:List(x:String)" DisplayName="Assign Problems" sap2010:WorkflowViewState.IdRef="Assign_2" To="[Problems]" Value="[{If(Cfg(&quot;OrchestratorQueueName&quot;) = &quot;Lyrebird_Validate&quot;, Nothing, $&quot;OrchestratorQueueName='{Cfg(&quot;OrchestratorQueueName&quot;)}'&quot;), If(Cfg(&quot;WishlistQueueName&quot;) = &quot;Lyrebird_Wishlist&quot;, Nothing, $&quot;WishlistQueueName='{Cfg(&quot;WishlistQueueName&quot;)}'&quot;), If(Cfg(&quot;OrchestratorQueueFolder&quot;) = &quot;Lyrebird&quot;, Nothing, $&quot;OrchestratorQueueFolder='{Cfg(&quot;OrchestratorQueueFolder&quot;)}'&quot;), If(Cfg(&quot;MaxRetryNumber&quot;) = &quot;0&quot;, Nothing, $&quot;MaxRetryNumber='{Cfg(&quot;MaxRetryNumber&quot;)}' (must be 0: Orchestrator retries)&quot;), If(Cfg(&quot;ShouldMarkJobAsFaulted&quot;).Equals(&quot;True&quot;, StringComparison.OrdinalIgnoreCase), Nothing, $&quot;ShouldMarkJobAsFaulted='{Cfg(&quot;ShouldMarkJobAsFaulted&quot;)}'&quot;), If(IsNumeric(Cfg(&quot;MaxConsecutiveSystemExceptions&quot;)) AndAlso CInt(Cfg(&quot;MaxConsecutiveSystemExceptions&quot;)) &gt;= 3, Nothing, $&quot;MaxConsecutiveSystemExceptions='{Cfg(&quot;MaxConsecutiveSystemExceptions&quot;)}' (needs &gt;= 3: one item can fail 3 times)&quot;), If(Config IsNot Nothing AndAlso Config.Values.Any(Function(v) Convert.ToString(v).Contains(&quot;ProcessABC&quot;)), &quot;template placeholder ProcessABC still present&quot;, Nothing), If(Config IsNot Nothing AndAlso Config.ContainsKey(&quot;ExScreenshotsFolderPath&quot;), &quot;ExScreenshotsFolderPath still configured (no screenshots in this process)&quot;, Nothing), If(TestMode, &quot;the configured queues resolve to TEST mode&quot;, Nothing), If(LoadQuery.Contains(&quot;message.not.like.LYREBIRD_IT*&quot;), Nothing, $&quot;production load query does not exclude test rows: {LoadQuery}&quot;)}.Where(Function(p) p IsNot Nothing).ToList()]" />
      <ui:LogMessage DisplayName="Log result" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[$&quot;Config: input '{Cfg(&quot;OrchestratorQueueName&quot;)}', output '{Cfg(&quot;WishlistQueueName&quot;)}', folder '{Cfg(&quot;OrchestratorQueueFolder&quot;)}', production load query '{LoadQuery}'. {Problems.Count} problem(s){If(Problems.Count = 0, String.Empty, &quot;: &quot; &amp; String.Join(&quot;; &quot;, Problems))}.&quot;]" />
      <uta:VerifyExpression AlternativeVerificationTitle="{x:Null}" KeepScreenshots="{x:Null}" OutputMessageFormat="{x:Null}" Result="{x:Null}" ScreenshotsPath="{x:Null}" ContinueOnFailure="False" DisplayName="Verify the Lyrebird production configuration" Expression="[Config IsNot Nothing AndAlso Problems.Count = 0]" sap2010:WorkflowViewState.IdRef="VerifyExpression_1" TakeScreenshotInCaseOfFailingAssertion="False" TakeScreenshotInCaseOfSucceedingAssertion="False" />
    </Sequence>
  </Sequence>
</Activity>